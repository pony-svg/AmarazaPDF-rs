[Desktop Entry]
Type=Application
Name=Amaraza PDF
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=pdfcraft %U
TryExec=pdfcraft
Icon=io.github.pony_svg.AmarazaPDF
Terminal=false
StartupNotify=true
StartupWMClass=io.github.pony_svg.AmarazaPDF
Categories=Office;Viewer;
Keywords=pdf;viewer;editor;annotate;sign;forms;merge;split;
MimeType=application/pdf;
